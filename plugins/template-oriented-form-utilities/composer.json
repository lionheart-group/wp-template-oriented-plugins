{
    "name": "lionheart-group/template-oriented-form-utilities",
    "description": "Template-Oriented Form Utilities",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "TofuPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TofuPlugin\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "LionHeart Group",
            "email": "info@lionheart.co.jp"
        }
    ],
    "config": {
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "monolog/monolog": "^2.9",
        "wixel/gump": "^2.3",
        "php": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpstan/extension-installer": "^1.3",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "test:scoped": "phpunit -c phpunit.scoped.xml",
        "check": [
            "@phpstan",
            "@test",
            "@test:scoped"
        ],
        "scoper": "php -d memory_limit=512M tools/php-scoper.phar add-prefix --config=scoper.inc.php --force",
        "scoper:composer": "php scripts/generate-build-composer.php",
        "scoper:dump": "composer dump-autoload --working-dir=build --classmap-authoritative",
        "build": [
            "@scoper",
            "@scoper:composer",
            "@scoper:dump"
        ]
    }
}
